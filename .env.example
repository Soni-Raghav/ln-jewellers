# ────────────────────────────────────────────────────────────────
# LN Jewellers — environment template
# Copy to .env and fill in. NEVER commit your real .env (gitignored).
# ────────────────────────────────────────────────────────────────

# ── DATABASE (required) ─────────────────────────────────────────
# Local development (SQLite — file is created by `npm run db:push`):
DATABASE_URL="file:./db/custom.db"

# Production (Vercel / Render — use a free Neon Postgres, see README):
#   1. create a database at https://neon.com (free tier)
#   2. copy the pooled connection string and paste it below
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/lnjewellers?sslmode=require"

# ── AUTH (required in production) ───────────────────────────────
# Secret used to sign session JWTs. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ── SITE URL ────────────────────────────────────────────────────
# Canonical public URL (used for metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── RAZORPAY (optional — enables online payments) ───────────────
# Leave empty to keep WhatsApp-only checkout (zero-config).
# Get keys at https://dashboard.razorpay.com → API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- AI studio photoshoot (choose one for production) ----
# Google AI Studio key (free): https://aistudio.google.com/apikey — recommended for Vercel
# GEMINI_API_KEY=
# z-ai gateway config JSON (reachable from this dev sandbox only)
# Z_AI_CONFIG={"baseUrl":"...","apiKey":"...","token":"...","chatId":"...","userId":"..."}
